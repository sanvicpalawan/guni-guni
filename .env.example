# --- Option A: Supabase (recommended for hosting) ---------------------------
# When both are set the app talks to Supabase (see supabase/README.md).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Option B: the bundled Node server ---------------------------------------
# Leave empty when the built site is served by `node server/index.mjs` (same origin).
# Set it when the site is hosted elsewhere, e.g. https://orders.guniguni.ph
VITE_API_URL=

# Server-side (node server/index.mjs) — not read by Vite:
# STAFF_PIN=2468      staff dashboard
# ADMIN_PIN=1357      backoffice (defaults to STAFF_PIN)
# PORT=8787
# DATA_DIR=./server/data
